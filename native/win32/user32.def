; USER32 entry points HYPRLODR uses for the title overlay.
; Converted to a .lib by llvm-dlltool in tools/build_windows.sh.
LIBRARY USER32.dll
EXPORTS
CreateWindowExA
DefWindowProcA
DispatchMessageA
DestroyWindow
EnumWindows
GetMessageA
GetAsyncKeyState
GetClientRect
GetDC
GetModuleHandleA
GetWindowRect
GetWindowThreadProcessId
IsWindowVisible
RegisterClassA
ReleaseDC
PostQuitMessage
SetWindowPos
SetTimer
SetWindowTextA
ShowWindow
TranslateMessage
UpdateLayeredWindow
UpdateWindow
